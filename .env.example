PORT=3000
GITHUB_ORG=seorilabs
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=
# Default AI review provider is MiniMax M3 (OpenAI-compatible Chat Completions).
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_API_BASE_URL=https://api.minimax.io/v1
MINIMAX_TIMEOUT_MS=180000
# Second AI review provider: GitHub Copilot CLI. Enabled with a small steady share
# (safety net) plus second-opinion escalation (see below).
COPILOT_GITHUB_TOKEN=
COPILOT_CLI_COMMAND=/app/node_modules/.bin/copilot
COPILOT_CLI_TIMEOUT_MS=180000
COPILOT_MODEL=auto
# Provider routing. MiniMax is primary; Copilot gets a small steady share and
# absorbs MiniMax cooldowns.
AI_REVIEW_PROVIDERS=minimax,copilot
AI_REVIEW_PROVIDER_WEIGHTS=minimax:100,copilot:10
AI_REVIEW_PROVIDER_FALLBACK_ORDER=minimax,copilot
AI_REVIEW_PROVIDER_COOLDOWN_MS=300000
# Independent fatal confirmation. A conservative gate FAIL is allowed only when
# this distinct provider returns the same host-grounded fatal blocker. Otherwise
# the result is ABSTAIN. Requires a positive provider weight and credentials.
AI_REVIEW_TIEBREAKER_ENABLED=true
AI_REVIEW_TIEBREAKER_PROVIDER=copilot
# Disabled by default. Code is preserved for future re-enable.
# GEMINI_PROVIDER=cli
# GEMINI_MODEL=
# GEMINI_CLI_COMMAND=/app/node_modules/.bin/gemini
# GEMINI_API_KEY=
# CURSOR_API_KEY=
# CURSOR_CLI_COMMAND=/usr/local/bin/agent
# CURSOR_MODEL=gpt-5.2
BOT_MENTIONS=@seorilabs-seori-pr-bot,@seorilabs-seori,@seori-bot,@seori,@gemini-cli,@gemini
TRUSTED_ASSOCIATIONS=OWNER,MEMBER,COLLABORATOR
ALLOW_PUBLIC_REPOS=false
AUTO_REVIEW_ON_OPEN=true
AUTO_REVIEW_ON_SYNCHRONIZE=false
# Conservative merge gate: checks host-recognized acceptance checklists/sections against current-HEAD
# test evidence and reports only fully evidenced fatal blockers. Parse/schema/context
# uncertainty becomes ABSTAIN; it never falls back to a free-form blocking review.
STRUCTURED_REVIEW_ENABLED=true
# Legacy human-like review options retained for configuration compatibility. They
# are not used by the conservative structured gate.
FOLLOWUP_ISSUE_ENABLED=false
FOLLOWUP_ISSUE_LABEL=seori-followup
BLOCK_ON_MEDIUM=false
# Dependency-bump fast-path. When enabled, dependabot/renovate dependency PRs skip the
# AI review entirely; Seori Review turns green once other CI checks pass (failing CI
# blocks, pending CI waits via the CI-recheck loop). Detection: PR author in
# DEPENDENCY_FASTPATH_AUTHORS or a PR label in DEPENDENCY_FASTPATH_LABELS.
DEPENDENCY_FASTPATH_ENABLED=false
DEPENDENCY_FASTPATH_AUTHORS=dependabot[bot],dependabot-preview[bot],renovate[bot],renovate
DEPENDENCY_FASTPATH_LABELS=dependencies
