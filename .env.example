PORT=3000
GITHUB_ORG=seorilabs
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=
# Default AI review provider is MiniMax M3 (OpenAI-compatible Chat Completions).
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_API_BASE_URL=https://api.minimax.io/v1
MINIMAX_TIMEOUT_MS=180000
# Optional fallback: GitHub Copilot CLI. Re-enable by setting AI_REVIEW_PROVIDERS
# to include "copilot" and giving it a positive weight. Quota returns 2026-07-01.
COPILOT_GITHUB_TOKEN=
COPILOT_CLI_COMMAND=/app/node_modules/.bin/copilot
COPILOT_CLI_TIMEOUT_MS=180000
COPILOT_MODEL=auto
# Disabled by default. Code is preserved for future re-enable.
# GEMINI_PROVIDER=cli
# GEMINI_MODEL=
# GEMINI_CLI_COMMAND=/app/node_modules/.bin/gemini
# GEMINI_API_KEY=
# CURSOR_API_KEY=
# CURSOR_CLI_COMMAND=/usr/local/bin/agent
# CURSOR_MODEL=gpt-5.2
BOT_MENTIONS=@seorilabs-seori-pr-bot,@seorilabs-seori,@seori-bot,@seori,@gemini-cli,@gemini
TRUSTED_ASSOCIATIONS=OWNER,MEMBER,COLLABORATOR
ALLOW_PUBLIC_REPOS=false
AUTO_REVIEW_ON_OPEN=true
AUTO_REVIEW_ON_SYNCHRONIZE=false